# Your Telegram bot token obtained using @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token

# Telegram user ID of admins, or - to assign no admin
ADMIN_USER_IDS=-

# Comma-separated Telegram user IDs, or * to allow all
ALLOWED_TELEGRAM_USER_IDS=*

# OpenRouter defaults. Users enter their own keys with /key in private chat.
# OPENROUTER_DEFAULT_MODEL=openrouter/auto
# OPENROUTER_HTTP_REFERER=https://your-deployment.example
# OPENROUTER_APP_TITLE=OpenRouter Telegram Bot
# OPENROUTER_PDF_ENGINE=cloudflare-ai
# OPENROUTER_REQUEST_TIMEOUT=180
# OPENROUTER_PROXY=http://localhost:8080

# Optional deployment-wide budgets
# BUDGET_PERIOD=monthly
# USER_BUDGETS=*
# GUEST_BUDGET=100.0

# Chat and Telegram behavior
# ENABLE_QUOTING=true
# ENABLE_IMAGE_GENERATION=true
# PROXY=http://localhost:8080
# ASSISTANT_PROMPT="You are a helpful assistant."
# SHOW_USAGE=true
# STREAM=true
# MAX_TOKENS=4096
# MAX_HISTORY_SIZE=15
# MAX_CONVERSATION_AGE_MINUTES=180
# TEMPERATURE=0.7
# PRESENCE_PENALTY=0.0
# FREQUENCY_PENALTY=0.0
# GROUP_TRIGGER_KEYWORD=""
# IGNORE_GROUP_ATTACHMENTS=true
# MAX_FILE_SIZE_MB=10
# TEXT_FILE_MAX_CHARS=200000
# SYSTEM_PROMPT_MAX_CHARS=12000
# MESSAGE_BATCH_WINDOW_SECONDS=1.25
# USER_SETTINGS_PATH=user_data/settings.json
# USAGE_LOGS_DIR=usage_logs
